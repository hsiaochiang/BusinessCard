            createdAt = now,\n            updatedAt = now,\n            lastContactAt = null,\n            isDeleted = false,\n            deletedAt = null,\n            syncStatus = SyncStatus.PENDING\n        )\n        dao.upsertDraft(draft)\n        return draft\n    }\n\n    suspend fun markStatus(localId: String, status: SyncStatus) {\n        dao.updateStatus(localId, status, timeProvider.nowIso())\n    }\n\n    suspend fun loadPendingOnce(): List<ContactDraftEntity> =\n        dao.getDraftsOnce(listOf(SyncStatus.PENDING, SyncStatus.FAILED))\n\n    fun observeContacts(query: ContactQuery): Flow<List<ContactRecord>> =\n        contactsFlow.map { list ->\n            list.asSequence()\n"},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Reordering imports and adding annotations**"}],"content":null,"encrypted_content":"gAAAAABpJGFLXB_QlB6bpZllrQSqTu9-Y8FJetustCr0SYGrOacnIPZYhLVdL-aQ-PTYr58oM72-zb9RA9_5cFP7wBxfysfxOMQACb4xbzp22OxHGeFBp_8U6PiEBctHdleM--YkVijl7RxvxCDVLGkpl9xxUvhZ1qv83vxQff9iLXpc6WBigQEtjP9SNpzNixPehHYJl-8_oah_lKKIHcMfkd0LDfDp2htuFQta05mMk8d0rPSnzIIXkCPpTSaqmsfG1WFGIz1ZO_e8CV6MsLV6ouf0BHV8OwxSnBvjTa2FNASA6GDPRviw-W_gUIFUkLFFRyaSwb1HerKgbzbDqR7yB_tDZvxsCWrzF9TIJX0cCJYLJDduZKHm-GLs7y0B-dIsHLgNjkSRy5nkzLqaF8dMfqCdeVyJWc-t7lXHCqC32SyauaWY3APrqNZGIbygBzaCyeNsEWyWuTwW0mYBjrYebhVqf_ogwhLXBBrdqJ8AFkKt4fDFz7hhn19DixkBgoJRNVOyGL_nuGG1dRyaSu0boL2dNw4D5oF23QrAFZlGw_-y213Q0cTNeaqrMQiS9C4CIXhfaltQXyoig-ePeu8uRiKl8SQsaKQt0NUgTA6zD_mP8NtG81fA9Z0yKrvD6D0DRk6E2R7NmFymkJejFj9OEw3O1_ZB1Sko-51H3_D6xFhvlzr-ttSh9KDOfrSywE2AHjUKJqN7cK2kptD3pjEHPsn516GZENbuaJHWoMqvhP4CSorjjy-9jmhnkaf2LCrrc2TpicxGogKvjrYUFgOaZVzwXnh71FA9ocF6VbOThORcFlhmIZkQlg94VxMDjWAhDXIvRmzMrPgQP3jusmPXAOkTj-4sfdWx-zZOu7ZdgT_uRhcw8wbIo2tkqE-pZ5Nnp4KXncaIP6W5dn9Ag00Vl8R_pEkA51STK83NeqwevYV-muHbn3J0ll6UtzYuDBRZUHo9PluoeepBOIDRIKFz7dTufx2VPKhIQibHXCiPFxQWHWyCn5pfD329mab7P4BUKe3OAJWjSz7R5azOEBBniy-TnUflliaDRFZ_7KYU7_1vqBVZamZpRgqmQoQvh6NtRyuu1vzI3Iud1aEHGANXvpr2Te4DoA2xtH_shjkatsCuymCJKzBuXtqZqE