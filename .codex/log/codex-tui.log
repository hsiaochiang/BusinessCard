kPolicy\n+import androidx.work.OneTimeWorkRequestBuilder\n+import androidx.work.WorkManager\n+import com.businesscard.app.data.repository.ContactDraftForm\n+import com.businesscard.app.data.repository.ContactRepository\n+import com.businesscard.app.sync.UploadWorker\n+\n+class CreateContactUseCase(\n+    private val repository: ContactRepository,\n+    private val workManager: WorkManager\n+) {\n+\n+    suspend fun saveDraft(form: ContactDraftForm) {\n+        repository.createDraft(form)\n+        enqueueUpload()\n+    }\n+\n+    private fun enqueueUpload() {\n+        val request = OneTimeWorkRequestBuilder<UploadWorker>()\n+            .addTag(UploadWorker.TAG)\n+            .build()\n+        workManager.enqueueUniqueWork(\n+            UploadWorker.WORK_NAME,\n+            ExistingWorkPolicy.KEEP,\n+            request\n+        )\n+    }\n+}\n*** End Patch"},{"type":"custom_tool_call_output","call_id":"call_Q53fHvOARAAPkBX0p1JQINSF","output":"{\"output\":\"Success. Updated the following files:\\nA android-app/app/src/main/java/com/businesscard/app/domain/create/CreateContactUseCase.kt\\n\",\"metadata\":{\"exit_code\":0,\"duration_seconds\":0.0}}"},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Adding UploadWorker and its factory**"}],"content":null,"encrypted_content":"gAAAAABpJAHSv5gOjaPLcgmmjefPed03QHuR3IlNnD9eK2R1jii8JMrUZQlwtBowjv1-XzKHXPrL_dxfYPcbv4_GQ3XOWfHS1IbXaBWGg1Y3TibQpNIa-lzygRNRX82yqGEKwtNig-pmx1ZUEqT3lQcEF-TU6WNhf0LUn7j5Khte0c7FZcUU62P8UI24l35ScrRRKfHgBDWCHgRmRxUyR8PT3lSzaT6Xavku5r07d7_Y03gRfE9fp01Ah7WhCYBRpU0YZb7AopljzCe4vHxX34jnQjvlbYgPUSo1Z6I9nOnQh8zPppixJ50ktFf7m7hcapYQSqg5bu65TdezJAJYwq4-NNz56EhMoDhKqjOcNQSkNOnEPijlO60WXDuiIFeQfWBPTmgSKzI1Eo46CLx_MC1uqh7BKOa0W_WORqNUwsgEGB8inIhbPBMI9xKAcLTor_BOUUoeAPvCWn4-Pdmvo9oYij2719CTvb4UjkwwcHz2J9dghgCPrikG-nh4txLVKhXG4A5TZ6MIkZls2aWi_BGnKLeriBgb37QLaio1J3IvY6V_tvhW5GTALylN7UdYbjCXIkVubHfPTKHy_ukU_G6Bg_HDS5IYB02ErjZjKbaFulxTRzkFZykU3EBYjwiNNCmSdVl_VQ-VARmBBls0EOcxeN367QGQ2cenSbWkZO44hGj