er\n\nenum class PermissionDecision {\n    GRANTED,\n    DENIED,\n    PERMANENTLY_DENIED\n}\n\nenum class PermissionScope {\n    STORAGE,\n    DRIVE\n}\n\ndata class PermissionResult(\n    val decision: PermissionDecision,\n    val token: String? = null,\n    val decidedAt: String = OffsetDateTime.now(ZoneOffset.ofHours(8))\n        .format(DateTimeFormatter.ISO_OFFSET_DATE_TIME)\n)\n\n/**\n * Fake Google Drive 授權檢查：使用注入的 token provider 與狀態 provider。\n * 不呼叫真 API，僅回傳 GRANTED / DENIED / PERMANENTLY_DENIED。\n */\nclass PermissionChecker(\n    private val fakeTokenProvider: () -> String?,\n    private val fakePermissionState: () -> PermissionDecision\n) {\n    fun check(scopes: Set<PermissionScope>): PermissionResult {\n        if (scopes.isEmpty()) {\n            return PermissionResult(decision = DENIED, token = null)\n        }\n        val decision = fakePermissionState.invoke()\n        return when (decision) {\n            GRANTED -> PermissionResult(decision = GRANTED, token = fakeTokenProvider.invoke())\n            DENIED -> PermissionResult(decision = DENIED, token = null)\n            PERMANENTLY_DENIED -> PermissionResult(decision = PERMANENTLY_DENIED, token = null)\n        }\n    }\n}\n```\n\n---\n\n### android-app/app/src/main/java/com/businesscard/app/us3/security/ConsistencyPolicy.kt\n```kotlin\npackage com.businesscard.app.us3.security\n\nimport java.time.OffsetDateTime\nimport java.time.ZoneOffset\nimport java.time.format.DateTimeFormatter\n\nenum class ConsistencyDecision {\n    USE_REMOTE,\n    USE_LOCAL,\n    NO_ACTION\n}\n\n/**\n * 純邏輯策略：\n * - remote > local  => USE_REMOTE\n * - local > remote  => USE_LOCAL\n * - remote 缺失     => USE_LOCAL\n * - 兩者皆無或相同  => NO_ACTION\n */\nclass ConsistencyPolicy {\n    fun decide(localUpdatedAt: String?, remoteUpdatedAt: String?): ConsistencyDecision {\n        val remote = remoteUpdatedAt?.let { parseTime(it) }\n        val local = localUpdatedAt?.let { parseTime(it) }\n        return when {\n            remote == null && local != null -> ConsistencyDecision.USE_LOCAL\n            remote != null && local == null -> ConsistencyDecision.USE_REMOTE\n            remote == null && local == null -> ConsistencyDecision.NO_ACTION\n            remote != null && local != null && remote.isAfter(local) -> ConsistencyDecision.USE_REMOTE\n            remote != null && local != null && local.isAfter(remote) -> ConsistencyDecision.USE_LOCAL\n            else -> ConsistencyDecision.NO_ACTION\n        }\n    }\n\n    private fun parseTime(value: String): OffsetDateTime =\n        OffsetDateTime.parse(\n            value,\n            DateTimeFormatter.ISO_OFFSET_DATE_TIME.withZone(ZoneOffset.ofHours(8))\n        )\n}\n```\n\n---\n\n### android-app/app/src/main/java/com/businesscard/app/data/repository/ContactRepository.kt\n```kotlin\npackage com.businesscard.app.data.repository\n\nimport com.businesscard.app.core.IdGenerator\nimport com.businesscard.app.core.TimeProvider\nimport com.businesscard.app.data.db.ContactDao\nimport com.businesscard.app.data.remote.drive.DriveClient\nimport com.businesscard.app.data.remote.drive.DriveUploadResult\nimport com.businesscard.app.data.remote.sheets.SheetsClient\nimport com.businesscard.app.data.remote.sheets.SheetsReader\nimport com.businesscard.app.data.remote.sheets.SheetsWriteResult\nimport com.businesscard.app.model.ContactDraftEntity\nimport com.businesscard.app.model.ContactQuery\nimport com.businesscard.app.model.ContactRecord\nimport com.businesscard.app.model.SortBy\nimport com.businesscard.app.model.Source\nimport com.businesscard.app.model.SyncStatus\nimport com.businesscard.app.telemetry.Telemetry\nimport java.util.UUID\nimport kotlinx.coroutines.flow.Flow\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.map\n\ndata class ContactDraftForm(\n    val name: String,\n    val company: String? = null,\n    val title: String? = null,\n    val email: String? = null,\n    val phone: String? = null,\n    val tags: List<String> = emptyList(),\n    val notes: String? = null,\n    val imagePath: String? = null\n)\n\n@Suppress(\"LongParameterList\")\nclass ContactRepository(\n    private val dao: ContactDao,\n    private val driveClient: DriveClient,\n    private val sheetsClient: SheetsClient,\n    private val sheetsReader: SheetsReader,\n    private val idGenerator: IdGenerator,\n    private val timeProvider: TimeProvider,\n    private val telemetry: Telemetry\n) {\n\n    private val contactsFlow = MutableStateFlow<List<ContactRecord>>(emptyList())\n\n    private fun nowIso(): String = timeProvider.nowIso()\n\n    suspend fun createDraft(form: ContactDraftForm): ContactDraftEntity {\n        val id = idGenerator.generate()\n        val now = nowIso()\n        val draft = ContactDraftEntity(\n            localId = UUID.randomUUID().toString(),\n            generatedId = id,\n            name = form.name,\n            company = form.company,\n            title = form.title,\n            email = form.email,\n            phone = form.phone,\n            tags = form.tags.joinToString(\",\"),\n            notes = form.notes,\n            imagePath = form.imagePath,\n            createdAt = now,\n            updatedAt = now,\n            lastContactAt = null,\n            isDeleted = false,\n            deletedAt = null,\n            syncStatus = SyncStatus.PENDING\n        )\n        dao.upsertDraft(draft)\n        return draft\n    }\n\n    suspend fun markStatus(localId: String, status: SyncStatus) {\n        dao.updateStatus(localId, status, nowIso())\n    }\n\n    suspend fun loadPendingOnce(): List<ContactDraftEntity> =\n        dao.getDraftsOnce(listOf(SyncStatus.PENDING, SyncStatus.FAILED))\n\n    fun observeContacts(query: ContactQuery): Flow<List<ContactRecord>> =\n        contactsFlow.map { list ->\n            list.asSequence()\n                .filter { record ->\n                    val matchSearch = query.search.isNullOrBlank() || listOfNotNull(\n                        record.name,\n                        record.company,\n                        record.email,\n                        record.phone,\n                        record.tags?.joinToString(\",\")\n                    ).any { it.contains(query.search.orEmpty(), ignoreCase = true) }\n                    val matchDeleted = query.includeDeleted || !record.isDeleted\n                    matchSearch && matchDeleted\n                }\n                .sortedWith(\n                    when (query.sortBy) {\n                        SortBy.NAME -> compareBy(String.CASE_INSENSITIVE_ORDER) { it.name }\n                        SortBy.CREATED_AT -> compareBy { it.createdAt }\n                    }\n                )\n                .toList()\n        }\n\n    suspend fun refreshFromRemote(includeDeleted: Boolean) {\n        val fetched = mutableListOf<ContactRecord>()\n        var token: String? = null\n        do {\n            val page = sheetsReader.fetchPage(token, DEFAULT_PAGE_SIZE, includeDeleted)\n            fetched.addAll(page.records)\n            token = page.nextPageToken\n        } while (token != null)\n        contactsFlow.value = fetched\n    }\n\n    suspend fun getLocal(id: String): ContactRecord? = contactsFlow.value.firstOrNull { it.id == id }\n\n    suspend fun applyRemote(remote: ContactRecord) {\n        contactsFlow.value = contactsFlow.value\n            .filterNot { it.id == remote.id } + remote.copy(updatedAt = remote.updatedAt)\n    }\n\n    suspend fun updateContact(updated: ContactRecord) {\n        val now = nowIso()\n        val newRecord = updated.copy(updatedAt = now)\n        contactsFlow.value = contactsFlow.value.map { if (it.id == newRecord.id) newRecord else it }\n        sheetsClient.update(newRecord)\n    }\n\n    suspend fun softDelete(id: String) {\n        val now = nowIso()\n        val target = contactsFlow.value.firstOrNull { it.id == id } ?: return\n        val deleted = target.copy(isDeleted = true, deletedAt = now, updatedAt = now)\n        contactsFlow.value = contactsFlow.value.map { if (it.id == id) deleted else it }\n        sheetsClient.update(deleted)\n    }\n\n    suspend fun processDraft(draft: ContactDraftEntity): Boolean {\n        markStatus(draft.localId, SyncStatus.UPLOADING)\n        val uploadResult = draft.imagePath?.let { path ->\n            driveClient.upload(path, \"${draft.generatedId}.jpg\")\n        } ?: DriveUploadResult.Success(sharedUrl = \"\")\n\n        val sharedUrl = when (uploadResult) {\n            is DriveUploadResult.Success -> uploadResult.sharedUrl\n            is DriveUploadResult.Failure -> {\n                telemetry.recordSyncFailure(uploadResult.reason)\n                markStatus(draft.localId, SyncStatus.FAILED)\n                return false\n            }\n        }\n\n        val record = draft.asRecord(sharedUrl = sharedUrl.ifEmpty { null }).copy(updatedAt = nowIso())\n        val writeResult = sheetsClient.append(record.copy(source = Source.SCAN))\n        return when (writeResult) {\n            is SheetsWriteResult.Success -> {\n                markStatus(draft.localId, SyncStatus.SYNCED)\n                true\n            }\n            is SheetsWriteResult.Failure -> {\n                telemetry.recordSyncFailure(writeResult.reason)\n                markStatus(draft.localId, SyncStatus.FAILED)\n                false\n            }\n        }\n    }\n\n    private companion object {\n        const val DEFAULT_PAGE_SIZE = 50\n    }\n}\n```\n\n---\n\n### android-app/app/src/main/java/com/businesscard/app/sync/SyncCoordinator.kt\n```kotlin\npackage com.businesscard.app.sync\n\nimport com.businesscard.app.data.remote.sheets.SheetsReader\nimport com.businesscard.app.data.repository.ContactRepository\nimport com.businesscard.app.model.ContactRecord\nimport com.businesscard.app.us3.security.ConsistencyDecision\nimport com.businesscard.app.us3.security.ConsistencyPolicy\n\nclass SyncCoordinator(\n    private val repository: ContactRepository,\n    private val sheetsReader: SheetsReader,\n    private val consistencyPolicy: ConsistencyPolicy\n) {\n    /**\n     * 同步流程：\n     * 1) 取本地與遠端資料\n     * 2) 逐筆比較 updated_at\n     * 3) USE_LOCAL -> 上傳 fake remote\n     * 4) USE_REMOTE -> 覆蓋本地\n     * 5) NO_ACTION  -> 忽略\n     */\n    suspend fun syncSingle(id: String) {\n        val local = repository.getLocal(id)\n        val remote = fetchRemote(id)\n        val decision = consistencyPolicy.decide(local?.updatedAt, remote?.updatedAt)\n        when (decision) {\n            ConsistencyDecision.USE_LOCAL -> local?.let { repository.updateContact(it) }\n            ConsistencyDecision.USE_REMOTE -> remote?.let { repository.applyRemote(it) }\n            ConsistencyDecision.NO_ACTION -> Unit\n        }\n    }\n\n    private suspend fun fetchRemote(id: String): ContactRecord? {\n        val page = sheetsReader.fetchPage(pageToken = null, pageSize = 100, includeDeleted = true)\n        return page.records.firstOrNull { it.id == id }\n    }\n}\n```\n\n---\n\n### android-app/app/src/test/java/com/businesscard/app/us3/PermissionCheckerTest.kt\n```kotlin\npackage com.businesscard.app.us3\n\nimport com.businesscard.app.us3.auth.PermissionChecker\nimport com.businesscard.app.us3.auth.PermissionDecision\nimport com.businesscard.app.us3.auth.PermissionScope\nimport org.junit.Assert.assertFalse\nimport org.junit.Assert.assertTrue\nimport org.junit.Test\n\nclass PermissionCheckerTest {\n\n    private val grantedChecker = PermissionChecker(\n        fakeTokenProvider = { \"fake-token\" },\n        fakePermissionState = { PermissionDecision.GRANTED }\n    )\n    private val deniedChecker = PermissionChecker(\n        fakeTokenProvider = { null },\n        fakePermissionState = { PermissionDecision.DENIED }\n    )\n    private val permanentChecker = PermissionChecker(\n        fakeTokenProvider = { null },\n        fakePermissionState = { PermissionDecision.PERMANENTLY_DENIED }\n    )\n\n    @Test\n    fun deniesWhenNoScope() {\n        val decision = deniedChecker.check(emptySet())\n        assertFalse(decision.decision == PermissionDecision.GRANTED)\n    }\n\n    @Test\n    fun allowsWhenGranted() {\n        val decision = grantedChecker.check(setOf(PermissionScope.DRIVE))\n        assertTrue(decision.decision == PermissionDecision.GRANTED)\n        assertTrue(!decision.token.isNullOrBlank())\n    }\n\n    @Test\n    fun permanentlyDenied() {\n        val decision = permanentChecker.check(setOf(PermissionScope.DRIVE, PermissionScope.STORAGE))\n        assertTrue(decision.decision == PermissionDecision.PERMANENTLY_DENIED)\n    }\n}\n```\n\n---\n\n### android-app/app/src/test/java/com/businesscard/app/us3/ConsistencyPolicyTest.kt\n```kotlin\npackage com.businesscard.app.us3\n\nimport com.businesscard.app.us3.security.ConsistencyDecision\nimport com.businesscard.app.us3.security.ConsistencyPolicy\nimport org.junit.Assert.assertEquals\nimport org.junit.Test\n\nclass ConsistencyPolicyTest {\n\n    private val policy = ConsistencyPolicy()\n\n    @Test\n    fun remoteNewerShouldUseRemote() {\n        val result = policy.decide(\n            localUpdatedAt = \"2025-02-01T00:00:00+08:00\",\n            remoteUpdatedAt = \"2025-02-02T00:00:00+08:00\"\n        )\n        assertEquals(ConsistencyDecision.USE_REMOTE, result)\n    }\n\n    @Test\n    fun localNewerShouldUseLocal() {\n        val result = policy.decide(\n            localUpdatedAt = \"2025-02-03T00:00:00+08:00\",\n            remoteUpdatedAt = \"2025-02-02T00:00:00+08:00\"\n        )\n        assertEquals(ConsistencyDecision.USE_LOCAL, result)\n    }\n\n    @Test\n    fun noRemoteUsesLocal() {\n        val result = policy.decide(\n            localUpdatedAt = \"2025-02-03T00:00:00+08:00\",\n            remoteUpdatedAt = null\n        )\n        assertEquals(ConsistencyDecision.USE_LOCAL, result)\n    }\n\n    @Test\n    fun bothNullNoAction() {\n        val result = policy.decide(\n            localUpdatedAt = null,\n            remoteUpdatedAt = null\n        )\n        assertEquals(ConsistencyDecision.NO_ACTION, result)\n    }\n}\n```\n\n---\n\n這些檔案均遵守 ImportOrdering（無空行，字典序），邏輯上僅針對 US3 T034–T035 同步與權限一致性需求，未改動 US1/US2 行為。請套用後執行上述指令確認。"}]},{"type":"message","role":"user","content":[{"type":"input_text","text":"/prompts:speckit.implement 你是 Codex。請開始實作 US3 — T036（ViewModel 行為與狀態邏輯）。  \n請保持 US1、US2 行為完整無改動，僅在必要時擴充。\n\n============================================================\n【本輪範圍：T036 — US3 ViewModel】\n============================================================\n\n■ 1. 檔案位置  \nandroid-app/app/src/main/java/com/businesscard/app/ui/contacts/ContactsViewModel.kt  \nandroid-app/app/src/main/java/com/businesscard/app/ui/contacts/ContactsUiState.kt  \nandroid-app/app/src/main/java/com/businesscard/app/ui/contacts/ContactsUiEvent.kt\n\n若沒有上述檔案，請建立。\n\n■ 2. 需新增的 US3 UI State\n在 ContactsUiState 中加入：\n\n- permissionStatus: PermissionStatus  \n    - UNKNOWN\n    - GRANTED\n    - DENIED\n    - PERMANENTLY_DENIED\n\n- consistencyStatus: ConsistencyStatus  \n    - IDLE\n    - CHECKING\n    - APPLYING_LOCAL\n    - APPLYING_REMOTE\n    - ERROR\n\n■ 3. 需新增的 UI Event  \n在 ContactsUiEvent 中加入：\n\n- RequestDrivePermission\n- OnPermissionResult(granted: Boolean, permanentlyDenied: Boolean)\n- StartConsistencyCheck\n- OnConsistencyResolved(decision: ConsistencyDecision)\n- OnConsistencyError(message: String)\n\n■ 4. ViewModel 新增行為（請完整實作）  \nViewModel 需具備以下能力：\n\n### (A) 權限流程  \n1. receive(RequestDrivePermission) → 呼叫 PermissionChecker  \n2. 根據結果更新 permissionStatus  \n3. 若 PERMANENTLY_DENIED → UI 要能呈現「需前往設定」  \n\n### (B) 一致性流程  \nStartConsistencyCheck 時：\n\n1. 設 consistencyStatus = CHECKING  \n2. 從 repository 取得 local & remote  \n3. 呼叫 ConsistencyPolicy  \n4. 根據 decision 執行：\n\n- USE_LOCAL → consistencyStatus = APPLYING_LOCAL → 呼叫 repository.applyLocal()\n- USE_REMOTE → consistencyStatus = APPLYING_REMOTE → 呼叫 repository.applyRemote()\n- NO_ACTION → consistencyStatus = IDLE（不做任何事）\n\n5. 發生例外 → consistencyStatus = ERROR(message)\n\n請注意：**不得修改 repository、SyncCoordinator、PermissionChecker 等檔案**，若需呼叫，僅能使用現有介面。\n\n■ 5. 時間格式要求  \nViewModel 若需紀錄時間，一律使用：  \nISO 8601 + \"+08:00\"（台北時間）\n\n■ 6. 驗證條件  \n此版本必須能通過：\n\n.\\android-app\\gradlew.bat -p android-app :app:detekt  \n.\\android-app\\gradlew.bat -p android-app :app:testDebugUnitTest :app:jacocoTestReport  \n.\\android-app\\gradlew.bat -p android-app :app:check\n\n■ 7. 請輸出所有新增與修改的檔案完整內容。\n\n請開始執行。\n"}]},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Designing ViewModel and UI state with minimal repository changes**\n\nI'm working on implementing a ViewModel with UI state and events for consistency checks, carefully avoiding modifying the existing repository or other core classes. To handle missing applyLocal functionality, I'm planning to treat updateContact as a local apply and use existing repository methods along with injected interfaces or adapters to simulate needed data access. I'll create minimal state and event classes, incorporate permission checks, and draft tests using fakes to validate the logic while respecting the constraints around repository modifications."}],"content":null,"encrypted_content":"gAAAAABpJRlUfJySNaxXz54hNlDxV61FgzRzxNRfhIRXNjzv8uA3p_XSQj28mNU0m810m_oNkxPdLVwgCfgsNmFqGrFmYc3UOeodkjLZPZ4kiWxb-LoE-owvM2kUeYyvdRm4Zokao0VKOwiOYvvuIHQszNwI7uoJCHEepaOAdRdVdotu125xjCbBKuKkonNgFL3VwLdDSafva4y30wCKAmdXEK-4zDmxp41xxwtHuPycRtaZYs4ZdPJIzHJeFQ8gtOqbHzFR0tr5kY4yyZGVNbgorBEb-8aRCFPInHIX6Df8Q0z8lXD23OSEhtjGUXFwPurVJpn0BUb9_ozsgnnnnK8eQSiJSz0AnG9hpZRBEcvy7IDTk-9dY_e4_X2j_QzYhKsJSR23OxV4qd7lHtdHTTOKM3L1wqW2Ix6rg5kBrc2rZJ4F3PKFGekrKX5IJBx7vL5a3FAiPfuUL8gu2goxEL3vBI56f2MFFYt0_w-05EGLMgrCrf4V7UltXp1hX1gwaWEs6ulcTlko4Jar9EVaQyyRossyWx1wdSr4FVcEk57KoBFwK5f2RsInn_WeW4xlhrwxCTlVCAu70pv0c4pklCr6oUTx_fFdbr1xnpBxr_eNFEAr7uRmo-Siw1v4rBEBa7-xItFzvyvRpsCwhwA_3tIsR8medN3eIEdRf72ribjP26yKt8xm_EtiQ-VTCG2Gtdmd8WIDQd5X_mGIvv2piWJbOwTtXziYNYS_VGkEKlsLyWj2z4l74lspC6lATz0pF1j-BRxaUd31MYSdTFJfJ2dZgKfFnccZ_RI5RAUJUH73jyxKg2jmulHQ9Xzvxy1d4e