leStateFlow<List<ContactRecord>>(emptyList())\n46: \n47:     suspend fun createDraft(form: ContactDraftForm): ContactDraftEntity {\n48:         val id = idGenerator.generate()\n49:         val now = timeProvider.nowIso()\n50:         val draft = ContactDraftEntity(\n51:             localId = UUID.randomUUID().toString(),\n52:             generatedId = id,\n53:             name = form.name,\n54:             company = form.company,\n55:             title = form.title,\n56:             email = form.email,\n57:             phone = form.phone,\n58:             tags = form.tags.joinToString(\",\"),\n59:             notes = form.notes,\n60:             imagePath = form.imagePath,\n61:             createdAt = now,\n62:             updatedAt = now,\n63:             lastContactAt = null,\n64:             isDeleted = false,\n65:             deletedAt = null,\n66:             syncStatus = SyncStatus.PENDING\n67:         )\n68:         dao.upsertDraft(draft)\n69:         return draft\n70:     }\n71: \n72:     suspend fun markStatus(localId: String, status: SyncStatus) {\n73:         dao.updateStatus(localId, status, timeProvider.nowIso())\n74:     }\n75: \n76:     suspend fun loadPendingOnce(): List<ContactDraftEntity> =\n77:         dao.getDraftsOnce(listOf(SyncStatus.PENDING, SyncStatus.FAILED))\n78: \n79:     fun observeContacts(query: ContactQuery): Flow<List<ContactRecord>> =\n80:         contactsFlow.map { list ->\n81:             list.asSequence()\n82:                 .filter { record ->\n83:                     val matchSearch = query.search.isNullOrBlank() || listOfNotNull(\n84:                         record.name,\n85:                         record.company,\n86:                         record.email,\n87:                         record.phone,\n88:                         record.tags?.joinToString(\",\")\n89:                     ).any { it.contains(query.search.orEmpty(), ignoreCase = true) }\n90:                     val matchDeleted = query.includeDeleted || !record.isDeleted\n91:                     matchSearch && matchDeleted\n92:                 }\n93:                 .sortedWith(\n94:                     when (query.sortBy) {\n95:                         SortBy.NAME -> compareBy(String.CASE_INSENSITIVE_ORDER) { it.name }\n96:                         SortBy.CREATED_AT -> compareBy { it.createdAt }\n97:                     }\n98:                 )\n99:                 .toList()\n100:         }\n101: \n102:     suspend fun refreshFromRemote(includeDeleted: Boolean) {\n103:         val fetched = mutableListOf<ContactRecord>()\n104:         var token: String? = null\n105:         do {\n106:             val page = sheetsReader.fetchPage(token, DEFAULT_PAGE_SIZE, includeDeleted)\n107:             fetched.addAll(page.records)\n108:             token = page.nextPageToken\n109:         } while (token != null)\n110:         contactsFlow.value = fetched\n111:     }\n112: \n113:     suspend fun updateContact(updated: ContactRecord) {\n114:         val now = timeProvider.nowIso()\n115:         val newRecord = updated.copy(updatedAt = now)\n116:         contactsFlow.value = contactsFlow.value.map { if (it.id == newRecord.id) newRecord else it }\n117:         sheetsClient.update(newRecord)\n118:     }\n119: \n120:     suspend fun softDelete(id: String) {\n121:         val now = timeProvider.nowIso()\n122:         val target = contactsFlow.value.firstOrNull { it.id == id } ?: return\n123:         val deleted = target.copy(isDeleted = true, deletedAt = now, updatedAt = now)\n124:         contactsFlow.value = contactsFlow.value.map { if (it.id == id) deleted else it }\n125:         sheetsClient.update(deleted)\n126:     }\n127: \n128:     suspend fun processDraft(draft: ContactDraftEntity): Boolean {\n129:         markStatus(draft.localId, SyncStatus.UPLOADING)\n130:         val uploadResult = draft.imagePath?.let { path ->\n131:             driveClient.upload(path, \"${draft.generatedId}.jpg\")\n132:         } ?: DriveUploadResult.Success(sharedUrl = \"\")\n133: \n134:         val sharedUrl = when (uploadResult) {\n135:             is DriveUploadResult.Success -> uploadResult.sharedUrl\n136:             is DriveUploadResult.Failure -> {\n137:                 telemetry.recordSyncFailure(uploadResult.reason)\n138:                 markStatus(draft.localId, SyncStatus.FAILED)\n139:                 return false\n140:             }\n141:         }\n142: \n143:         val record = draft.asRecord(sharedUrl = sharedUrl.ifEmpty { null })\n144:         val writeResult = sheetsClient.append(record.copy(source = Source.SCAN))\n145:         return when (writeResult) {\n146:             is SheetsWriteResult.Success -> {\n147:                 markStatus(draft.localId, SyncStatus.SYNCED)\n148:                 true\n149:             }\n150:             is SheetsWriteResult.Failure -> {\n151:                 telemetry.recordSyncFailure(writeResult.reason)\n152:                 markStatus(draft.localId, SyncStatus.FAILED)\n153:                 false\n154:             }\n155:         }\n156:     }\n157: \n158:     private companion object {\n159:         const val DEFAULT_PAGE_SIZE = 50\n160:     }\n161: }\n"},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Organizing imports by lexicographic groups**"}],"content":null,"encrypted_content":"gAAAAABpJGaAnbCsdDlY1fAbdxL4saFFf-EiCpxTF4SPNl25fhnqLbuCzY7jv30MRN3a-Qs3KUl8ic7OE4-mkQZCnkNPxoRSLdmndrRxMjssFTOOUsVYGH6LQPSVe6Es7PmwY996N1cS3M9bmSr6vfa4pUnUMws2r8W049NAjEPXfnlQYBXApHboLjmO7qy9PPx1IHZAYmkbrYtqVVlJ3XYYTwgilcv_jK3nH0qhe5VJ80366CW0FfIv2ThuZZXaFg792BzW3CW5bORg93YXAGFnZdVDW7tAr7AS4ka29ZzgVK1DAB7kLvQX2GTF0xRnGzanTKzisW9GWcUvFZAkc2jBhx54_z7xbnNQlBnfFbd1Q6gykEVRECm_IAq8qwU2_rxk-_t-uTRpSFWnLW_NidpfxsAEmc28wAneC0yZKp71XCzYpO51NWwP1xHdFMaOtZaYjiA5EzG_ox7qV6fVVB50qS9bsiatK7ePQdMkwZO6yDeKy8JEokSbCnjoIl5V-IuLyYyFLCpqCcUCRBQyLpJu8hPS2jcLSLUqwX3bapGKEpVXG3uDsoMvFUBfGes1mhsgA0wg4AkSFs5TVVu3f4O1heyAC2131uQ8OeTMAmHVP3b6FL7aAfgxaJ67kOMVQMnOiEXxWSfjAvL8FJApdhV7-tt0pniPMrPLW1bl6