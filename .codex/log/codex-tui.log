rd> = emptyList()\n)\n\nclass ContactListViewModel(\n    private val repository: ContactRepository\n) : ViewModel() {\n\n    private val queryState = MutableStateFlow(ContactQuery())\n\n    val uiState: StateFlow<ContactListUiState> = queryState\n        .flatMapLatest { query ->\n            repository.observeContacts(query).map { contacts ->\n                ContactListUiState(\n                    search = query.search.orEmpty(),\n                    sortBy = query.sortBy,\n                    includeDeleted = query.includeDeleted,\n                    contacts = contacts\n                )\n            }\n        }\n        .stateIn(\n            scope = viewModelScope,\n            started = SharingStarted.Lazily,\n            initialValue = ContactListUiState()\n        )\n\n    fun setSearch(search: String) {\n        queryState.value = queryState.value.copy(search = search)\n    }\n\n    fun setSort(sortBy: SortBy) {\n        queryState.value = queryState.value.copy(sortBy = sortBy)\n    }\n\n    fun toggleIncludeDeleted(include: Boolean) {\n        queryState.value = queryState.value.copy(includeDeleted = include)\n    }\n\n    fun refresh(includeDeleted: Boolean = false) {\n        viewModelScope.launch {\n            repository.refreshFromRemote(includeDeleted = includeDeleted)\n        }\n    }\n}\n"},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Analyzing experimental annotation and import order**"}],"content":null,"encrypted_content":"gAAAAABpJGE9_RdMRmzzWJ4XQiv5XcgmkH8VqO7wGmv2vWzeAUFkbyprPoVr4ogqv1IrMJS8mIWcROP56NEwBx4Og5QmWqTi2FINwX1BR6t3_lBx90WmSvtVuexliPGDw6XwqtdxLFP_X_UoWKHOcK1CMMRvyhjoR8qp9GJQkfnY4CX2R3E0VhiXt8XDkS9h5NbX3vonPuR0vVcILE7mMolK-MNVv_Dp4X3lesNuqEmXbKyKL-bpCebj7kyJCqYH5Omnzj8WqiJEHXOTHmVNK8ne8oXIlSSAdeQes9FuAtsSKCHSv5vmTLdtVbyQgN-iptftTQLxAveCLdJYd98phkkV_C0gz_rJvZpfHeOrb1td3NeqScpZJZxNAq4pP4hrXKPKa5nOABgz2PVLCKv2UIu23-wjXAUs3GNUDnMPmKWFqxuXv4CD7y8VK5A7s8Se9FCfr2xtRgtUEOYzdATZNcvVXk9JBOMSsRr13dORqFrc-YxLKr1hRMxbT7FV5