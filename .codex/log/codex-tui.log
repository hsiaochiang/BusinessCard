ing(),\n            generatedId = id,\n            name = form.name,\n            company = form.company,\n            title = form.title,\n            email = form.email,\n            phone = form.phone,\n            tags = form.tags.joinToString(\",\"),\n            notes = form.notes,\n            imagePath = form.imagePath,\n            createdAt = now,\n            updatedAt = now,\n            lastContactAt = null,\n            isDeleted = false,\n            deletedAt = null,\n            syncStatus = SyncStatus.PENDING\n        )\n        dao.upsertDraft(draft)\n        return draft\n    }\n\n    suspend fun markStatus(localId: String, status: SyncStatus) {\n        dao.updateStatus(localId, status, timeProvider.nowIso())\n    }\n\n    suspend fun loadPendingOnce(): List<ContactDraftEntity> =\n        dao.getDraftsOnce(listOf(SyncStatus.PENDING, SyncStatus.FAILED))\n\n    suspend fun processDraft(draft: ContactDraftEntity): Boolean {\n        markStatus(draft.localId, SyncStatus.UPLOADING)\n        val uploadResult = draft.imagePath?.let { path ->\n            driveClient.upload(path, \"${draft.generatedId}.jpg\")\n        } ?: DriveUploadResult.Success(sharedUrl = \"\")\n\n        val sharedUrl = when (uploadResult) {\n            is DriveUploadResult.Success -> uploadResult.sharedUrl\n            is DriveUploadResult.Failure -> {\n                telemetry.recordSyncFailure(uploadResult.reason)\n                markStatus(draft.localId, SyncStatus.FAILED)\n                return false\n            }\n        }\n\n        val record = draft.asRecord(sharedUrl = sharedUrl.ifEmpty { null })\n        val writeResult = sheetsClient.append(record.copy(source = Source.scan))\n        return when (writeResult) {\n            is SheetsWriteResult.Success -> {\n                markStatus(draft.localId, SyncStatus.SYNCED)\n                true\n            }\n            is SheetsWriteResult.Failure -> {\n                telemetry.recordSyncFailure(writeResult.reason)\n                markStatus(draft.localId, SyncStatus.FAILED)\n                false\n            }\n        }\n    }\n}\n"},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Updating enum constants and fixing test issues**"}],"content":null,"encrypted_content":"gAAAAABpJEcbyXUOz7RqCRjeY6x0ntsjYhXF-aT7NseqpddLCAHOvojRMlnagRH-5Y7EEuTl8SEKYq6I1vmMDm_JrNh9X9e2jFbO_AAr2s1X7xK7l6cgjBBxQ6eDnJCwoajogMjRo8x-T1xaCFnbSuwKsg3h3-PHyTZTWctM8vSdSZ2ybuWinR2hn0OwsPWOz_MqIjdMZEI8V1vhCTblTq-5Kyx38LOKvYx6_fx4wdvycKgEB-j54OTopB_45FXfBol5l9z-M2x__HoIpiJBCJYNozdx_cawU-w6JctwqK-T-Pv7n7w4LnRU3VkdIHiemHNzbxBZlWvFMUEYPr1UAl0RO9Jz9r9Gg155oKEqf-S39TkRYdlfe6PFwWCqluzq3_oF9cEmPZAuCBdH4tgrJ6uO2wTVxlrce1kLZjFv8foIjGDvE9EzvEJG8b_TZqB8cwm1jS_R3x_Tfs-dZLg9sPJvXKljUz5sfmTIW9WamWDxkBBHg7zrfzG10ZG_SmWKAAHZ1UQhNMaLfXclD8ERC-KTwF0YBn1hDzxJZ-T_n4jO6shJJEJ5ExAx4lnJUHMpD9C1RqAKfuRM5yGGOVebxPfnDhUHTXHMgpSsYWvUyf_ZrpYxqti6bLBy5-stuHt-LAPXGyoqCmsanUg_ReOFirTuGoX2T1_bmzp5daU8wg2YAdIZ5Z871pLBozFb2SkTK_OM4kU7us5vTcThMnimByow0uEipMjh--oLyZ4npC9tm8uO4dqO7WhR8N0CBAmRjBBU5GF_pvjxTct2v3wb2UCWnq2Wb3uVjHBKo0FE3domZKuj25ySEBkgOgRkDT3ibWE1F07QA93k7M9frJvlmBUCYuIDfvMdtA8b1Ah-ao6Okevb8283LOTTkaY1KtCF1Eepp-1J55N6k4THb_ZtjmCcPKrO79No5pOnWu6cw7TWu5nuIqHa6Rwff-msSyIP7x3JsDAW9TGbEaxKKqX5e1PXSIys9-j_JMNESCbTjxwRbuIO-Hk093f-D8hPIGF2XvwBvSKZ9iNKUMc9sylies82PNIEjzDCyJPeQq-RC96o7R1IMT1C_HsfucDfGgxqbsScSudfdlB2gUKLEXE1ZkvgZAFgNBGiZy2Zj8FURMJIEM3kWfoN96aBRJyyOSBLPEpTEisQQd0NQYyT5aQgVVdCbosdPXZX5nSxGq-7aJ94krK-j7ePIPvcoQs_qhtlCVcC-5UTjpRPFQ0f2njN8eV568OsLNKdOh51lV1oSMVwjRGxPh-FMV1HQaWvT9Uqt5eTWlI_OVMP1_dj0UI1GMfsaITwv1zPuBlHhMYNdQXbuEhMZmxxPlj9VA0byzv-5AjCZkW5VRYYj7Xf-TLzl6WwFjJJCF75wT_72JSwMQ0YO1RM98pZeIcQQymqOPzHgKc7hWeYcqCkbuVkmAt3IoEIvoFbuYduhr3qrUYUMDfrQOVWGbOa7a3OR4DUBYQhW6JSJMLz1i9jAQghpoCssWTRkWyRGUZHjcNdcensZqz9o1d4bGJu1M3av-DaDpm17-EI4HaUtuDVE8-NpgH3rgJWGYeFY0SjN9nxX99cJoBWIFvo2TKg6ltdaE6MO67BFFqwIO2Uhl-NkuQYC7HVde6btmA3AD-MYHiIuugqGhcHXqRYV6a66cNw8uoExz_f_Ka3_OXyiMCCyXIawsdzwMUa_5lXqDXKk-5yJjsVyZB2gjJwprhu-63Ja