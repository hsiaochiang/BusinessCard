te.value = ScanUiState.Idle\n-    }\n-}\n-\n-sealed interface ScanUiState {\n-    data object Idle : ScanUiState\n-    data object Processing : ScanUiState\n-    data class ReadyForUpload(val preview: Bitmap) : ScanUiState\n-    data object Uploading : ScanUiState\n-    data object Uploaded : ScanUiState\n-    data class Error(val message: String) : ScanUiState\n-}\n+package com.businesscard.app.ui.scan\n+\n+import android.app.Application\n+import android.graphics.Bitmap\n+import androidx.lifecycle.AndroidViewModel\n+import androidx.lifecycle.viewModelScope\n+import com.businesscard.app.data.repository.ContactDraftForm\n+import com.businesscard.app.domain.create.CreateContactUseCase\n+import kotlinx.coroutines.flow.MutableStateFlow\n+import kotlinx.coroutines.flow.StateFlow\n+import kotlinx.coroutines.launch\n+\n+class ScanViewModel(\n+    application: Application,\n+    private val createContactUseCase: CreateContactUseCase,\n+    private val ocrProcessor: OcrProcessor,\n+    private val imageStore: ImageFileStore\n+) : AndroidViewModel(application) {\n+\n+    private val _uiState = MutableStateFlow<ScanUiState>(ScanUiState.Idle)\n+    val uiState: StateFlow<ScanUiState> = _uiState\n+\n+    fun onImageCaptured(bitmap: Bitmap?) {\n+        if (bitmap == null) {\n+            _uiState.value = ScanUiState.Error(\"未取得影像\")\n+            return\n+        }\n+        _uiState.value = ScanUiState.Processing\n+        viewModelScope.launch {\n+            val savedPath = imageStore.save(bitmap)\n+            val ocr = ocrProcessor.process(bitmap)\n+            val form = ContactDraftForm(\n+                name = ocr.name.ifBlank { \"未命名名片\" },\n+                company = ocr.company,\n+                title = ocr.title,\n+                email = ocr.email,\n+                phone = ocr.phone,\n+                tags = ocr.tags,\n+                notes = ocr.notes,\n+                imagePath = savedPath\n+            )\n+            createContactUseCase.saveDraft(form)\n+            _uiState.value = ScanUiState.Uploading\n+            _uiState.value = ScanUiState.Uploaded\n+        }\n+    }\n+\n+    fun onUploadTriggered() {\n+        _uiState.value = ScanUiState.Uploading\n+        createContactUseCase.enqueueUploadOnly()\n+    }\n+\n+    fun reset() {\n+        _uiState.value = ScanUiState.Idle\n+    }\n+}\n+\n+sealed interface ScanUiState {\n+    data object Idle : ScanUiState\n+    data object Processing : ScanUiState\n+    data object Uploading : ScanUiState\n+    data object Uploaded : ScanUiState\n+    data class Error(val message: String) : ScanUiState\n+}\n*** End Patch"},{"type":"custom_tool_call_output","call_id":"call_1pSZXlL7jGVxLedmc6tVYzhA","output":"{\"output\":\"Success. Updated the following files:\\nM android-app/app/src/main/java/com/businesscard/app/ui/scan/ScanViewModel.kt\\n\",\"metadata\":{\"exit_code\":0,\"duration_seconds\":0.0}}"},{"type":"reasoning","summary":[{"type":"summary_text","text":"**Creating ViewModel factory**"}],"content":null,"encrypted_content":"gAAAAABpJAIz31VQbuhl6MHfb318i3VQ1KJmwhvUkNsPSZuia28X4F0iXJRwwouBH7MiBt6NtaLCPNanIYHnoNiaUEdVU32LxYi9v56n-kzkAbcnlDz4UbIkoOevwkIOGNakVxlofOi5K1YBs3sJqIPT-XLzhH-4VVc1HZSvyC7pebuH-8YZLVMeTjM6nnWdHbvIs5kVSzIIn7Kgd46fAtTA5lWNz_KDYfy7srTKvYivSh1huj6i9FhxZb0stFjW8VSKaI3T7KnNm3YpBPi4hkhy_bdN4SgNHz2RTbefdi5RycUkhosh7AYldP8Q3cGvZoqjBjTIsXKZ1tryGQjEb5HSAbHfAtijB1HTklerxOfQNTAP4oOowwAc681vdVoHgBlYtqxP_rwCL4Cye_WSIOdGoLyDEOA_MZBMPswQXcuqD3VBXl2qsWBWw7HJG6wIdarX0XvwwhXQcMOFzunnYnGnv7UDnfg9QtBP1UU_J4pGU_JUDVPewtXK3QFNgwe_lGJZ4917DJ6WFUlkhcmLqMFKvF7kmpz77LbSIV_mb7YIBFddr9WXmwDyvNXLMZd1wsNjMONOrYxK2K-WaVTq2GgC8abAciMz_8328_BKjgh3q7kzSeJ6gP0lsgbe6aUG1_6rmMaKZS-gG-W75lYfNHxo-V_naCKCXhLBG8BcPo8LWwx66NgZJkaFORzgluyq-bgUjny2OQjXwYYCL-lGQjnLMtBZw9ToOQH1xTRTc4D0IlXKAxZvvGP-1u5RsPunmdOiYbCNL-sfB59PxIcKN9P6KCdflOBj3Fgfs8LMlNyVQLv1Ydx4QA-8FBq8wmfMce2sK7XG9FhUarFHtKWWole-VAN4l5cPmxVm0-h1J8AURrv1JO6HGVBQJ2L6khPp_0HW2J-_dC69Xks0dSjvuzIEAeWPgNaByOPwB-AthjmPWyxx_sBVTTHI3T7V8E6N9WJO